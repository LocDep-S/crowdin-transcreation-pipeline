# Port the Express server listens on
PORT=3000

# Public HTTPS URL Crowdin will load this app from (Render URL once deployed).
# Overrides manifest.json's baseUrl at request time.
PUBLIC_BASE_URL=https://your-render-app.onrender.com

# Upstash Redis (Console -> your database -> REST API section). Persistent
# storage for Crowdin installation credentials - required since Render's
# free tier has no persistent local disk. Reuses the same pattern as the
# Subtitle Video & Timing Editor app; can be the SAME Upstash database
# (different key namespace) or a fresh one - either works, see lib/store.js.
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Crowdin OAuth Application credentials (Organization Settings -> OAuth apps
# -> register a new one for "Transcreation Pipeline"). NOT YET CONFIRMED
# whether a workflow-step-type app with authenticationType "crowdin_agent"
# needs this same registered-OAuth-app step that the crowdin_app-authenticated
# subtitle-timing-app needed (see lib/crowdinAuth.js header comment) - this is
# the precedent's pattern, carried over as the working assumption pending a
# real install test.
CROWDIN_CLIENT_ID=your-oauth-app-client-id
CROWDIN_CLIENT_SECRET=your-oauth-app-client-secret

# Vertex AI (Gemini), authenticated via a GCP service account. All 5
# pipeline stages (cultural audit, data localization, local GEO, brief,
# writing/QA/polish) AND the /api/regenerate endpoint call Vertex AI's
# Gemini API directly through lib/gemini.js - NOT through Crowdin's own AI
# Prompt system (that was tried first; it only supports translate/QA-shaped
# prompts, not this pipeline's freeform multi-stage reasoning), and NOT the
# separate Gemini Developer API / Google AI Studio (a simple `AIza...` key -
# a different product with different auth, not used here - see
# lib/gemini.js's header for the full story). AI spend for this pipeline is
# billed to the GCP project below, not an org-level Crowdin AI provider.
#
# SECURITY: the service account's full JSON keyfile is uploaded as a Render
# Secret File (e.g. gcp-service-account.json), never committed here, never
# anywhere else in this repo, which is public. Never log the raw value or
# the raw error/response object from a failed Vertex AI call
# (lib/gemini.js's withDetailedErrors surfaces only a safe subset of fields
# - keep it that way in any edit).
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# Path Render mounts the uploaded Secret File at - see render.yaml's comment.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/gcp-service-account.json

# Optional - overrides lib/gemini.js's DEFAULT_MODEL for every pipeline
# stage. Per-stage model tiering (e.g. a cheaper/faster model for the more
# mechanical stages vs. the strongest available model for writing/QA) is an
# explicitly open decision - see the plan doc - not yet implemented.
# "-preview" models (like the default below) can change or be retired with
# less notice than a GA model - gemini-2.5-pro is the stable fallback.
# GEMINI_MODEL=gemini-3.1-pro-preview

# Shared secret the serverless Regenerate panel (crowdin-transcreation-panel,
# a separate app/repo) sends when calling POST /api/regenerate on this
# service. This is a placeholder scheme, not a final design - see the "Open
# design question" note in the plan doc (Phase 2b.3) and README.md here for
# what still needs deciding before this is trustworthy in production.
REGENERATE_ENDPOINT_SHARED_SECRET=change-me-placeholder
