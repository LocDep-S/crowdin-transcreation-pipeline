# Port the Express server listens on
PORT=3000

# Public HTTPS URL Crowdin will load this app from (Render URL once deployed).
# Overrides manifest.json's baseUrl at request time.
PUBLIC_BASE_URL=https://your-render-app.onrender.com

# Upstash Redis (Console -> your database -> REST API section). Persistent
# storage for Crowdin installation credentials - required since Render's
# free tier has no persistent local disk. Reuses the same pattern as the
# Subtitle Video & Timing Editor app; can be the SAME Upstash database
# (different key namespace) or a fresh one - either works, see lib/store.js.
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Crowdin OAuth Application credentials (Organization Settings -> OAuth apps
# -> register a new one for "Transcreation Pipeline"). NOT YET CONFIRMED
# whether a workflow-step-type app with authenticationType "crowdin_agent"
# needs this same registered-OAuth-app step that the crowdin_app-authenticated
# subtitle-timing-app needed (see lib/crowdinAuth.js header comment) - this is
# the precedent's pattern, carried over as the working assumption pending a
# real install test.
CROWDIN_CLIENT_ID=your-oauth-app-client-id
CROWDIN_CLIENT_SECRET=your-oauth-app-client-secret

# Anthropic API key used for all 5 pipeline stages (cultural audit, data
# localization, local GEO, brief, writing/QA) AND for the /api/regenerate
# endpoint the separate serverless Regenerate panel calls into. This is the
# one secret this whole two-app architecture exists to keep server-side -
# never expose it to the panel's bundle. Paid by Sinch directly (not
# Crowdin's managed AI credits) - see "still open" cost-ownership item in
# the plan doc.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Shared secret the serverless Regenerate panel (crowdin-transcreation-panel,
# a separate app/repo) sends when calling POST /api/regenerate on this
# service. This is a placeholder scheme, not a final design - see the "Open
# design question" note in the plan doc (Phase 2b.3) and README.md here for
# what still needs deciding before this is trustworthy in production.
REGENERATE_ENDPOINT_SHARED_SECRET=change-me-placeholder
